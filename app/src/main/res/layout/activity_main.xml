<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFCFD"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- POSHANDRISHTI LOGO -->

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="200dp"
            android:layout_height="145dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:adjustViewBounds="true"
            android:contentDescription="PoshanDrishti Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/poshan_logo" />

        <!-- BRAND NAME -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="PoshanDrishti"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#075B37"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- TAGLINE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Monitor  •  Assess  •  Nourish  •  Grow"
            android:textColor="#245B36"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- LOGIN CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_login_card"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- LOGIN HEADING -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="♟  Login to Continue"
                android:textColor="#075B37"
                android:textSize="25sp"
                android:textStyle="bold" />

            <!-- SELECT ROLE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="12dp"
                android:text="Select Your Role"
                android:textColor="#222222"
                android:textSize="17sp" />

            <!-- ROLE BUTTONS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- ANGANWADI WORKER -->

                <TextView
                    android:id="@+id/roleAnganwadi"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_role_selected"
                    android:drawableTop="@drawable/ic_anganwadi"
                    android:drawableTint="#FFFFFF"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Anganwadi&#10;Worker ✓"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- HEALTHCARE WORKER -->

                <TextView
                    android:id="@+id/roleHealthcare"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginHorizontal="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_role_unselected"
                    android:drawableTop="@drawable/ic_healthcare"
                    android:drawableTint="#075B37"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Healthcare&#10;Worker"
                    android:textColor="#075B37"
                    android:textSize="13sp" />

                <!-- BLOCK / ADMIN OFFICER -->

                <TextView
                    android:id="@+id/roleAdmin"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_role_unselected"
                    android:drawableTop="@drawable/ic_admin"
                    android:drawableTint="#075B37"
                    android:drawablePadding="2dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="Block / Admin&#10;Officer"
                    android:textColor="#075B37"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- MOBILE NUMBER -->

            <EditText
                android:id="@+id/etMobile"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_input"
                android:hint="☎   Mobile Number"
                android:inputType="phone"
                android:maxLength="10"
                android:padding="14dp"
                android:singleLine="true"
                android:textColor="#222222"
                android:textSize="16sp" />

            <!-- PASSWORD CONTAINER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <!-- PASSWORD FIELD -->

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="🔒   Password"
                    android:inputType="textPassword"
                    android:padding="8dp"
                    android:singleLine="true"
                    android:textColor="#222222"
                    android:textSize="16sp" />

                <!-- PASSWORD VISIBILITY -->

                <TextView
                    android:id="@+id/tvTogglePassword"
                    android:layout_width="45dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◉"
                    android:textColor="#075B37"
                    android:textSize="22sp" />

            </LinearLayout>

            <!-- FORGOT PASSWORD -->

            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:padding="5dp"
                android:text="Forgot Password?"
                android:textColor="#075B37"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- LOGIN BUTTON -->

            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_primary_button"
                android:backgroundTint="@null"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <!-- OR DIVIDER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="──────────  or  ──────────"
                android:textColor="#777777"
                android:textSize="15sp" />

            <!-- OTP BUTTON -->

            <Button
                android:id="@+id/btnOtp"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_otp_button"
                android:backgroundTint="@null"
                android:text="▣  Login with OTP"
                android:textAllCaps="false"
                android:textColor="#075B37"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FOOTER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="15dp"
            android:gravity="center"
            android:text="Anganwadi Kendra  •  PoshanDrishti"
            android:textColor="#397C4C"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
