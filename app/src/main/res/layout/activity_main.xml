<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDFCFD"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- MAIN LOGIN CONTENT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- POSHANDRISHTI LOGO -->

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="190dp"
                android:layout_height="125dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:src="@drawable/poshan_logo"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:contentDescription="PoshanDrishti Logo"/>

            <!-- BRAND NAME -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="PoshanDrishti"
                android:fontFamily="@font/poppins_bold"
                android:textColor="#075B37"
                android:textSize="32sp"
                android:textStyle="bold"/>

            <!-- TAGLINE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Monitor  •  Assess  •  Nourish  •  Grow"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#245B36"
                android:textSize="12sp"/>

            <!-- LOGIN CARD -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_login_card"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- LOGIN HEADING -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="♟  Login to Continue"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="#075B37"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

                <!-- SELECT ROLE -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:layout_marginBottom="10dp"
                    android:text="Select Your Role"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#222222"
                    android:textSize="15sp"/>

                <!-- ROLE BUTTONS -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <!-- ANGANWADI WORKER -->

                    <LinearLayout
                        android:id="@+id/roleAnganwadi"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_role_selected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/ic_anganwadi"
                            android:scaleType="fitCenter"
                            app:tint="#FFFFFF"
                            android:contentDescription="Anganwadi Worker"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Anganwadi&#10;Worker ✓"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="#FFFFFF"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- HEALTHCARE WORKER -->

                    <LinearLayout
                        android:id="@+id/roleHealthcare"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:background="@drawable/bg_role_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/doctor"
                            android:scaleType="fitCenter"
                            app:tint="#075B37"
                            android:contentDescription="Healthcare Worker"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Healthcare&#10;Worker"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#075B37"
                            android:textSize="10sp"/>

                    </LinearLayout>

                    <!-- BLOCK / ADMIN OFFICER -->

                    <LinearLayout
                        android:id="@+id/roleAdmin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/bg_role_unselected"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="4dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:src="@drawable/govenment_building"
                            android:scaleType="fitCenter"
                            app:tint="#075B37"
                            android:contentDescription="Admin Officer"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Block / Admin&#10;Officer"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#075B37"
                            android:textSize="10sp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- HEALTHCARE ILLUSTRATION -->

                <ImageView
                    android:id="@+id/ivHealthcareIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Healthcare worker illustration"
                    android:scaleType="fitCenter"
                    android:src="@drawable/healthcare_illustration"
                    android:visibility="gone"/>

                <!-- BLOCK / ADMIN ILLUSTRATION -->

                <ImageView
                    android:id="@+id/ivAdminIllustration"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Block Admin Officer illustration"
                    android:scaleType="centerCrop"
                    android:src="@drawable/block_admin_logo"
                    android:visibility="gone"/>

                <!-- MOBILE NUMBER -->

                <EditText
                    android:id="@+id/etMobile"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_input"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="☎   Mobile Number"
                    android:inputType="phone"
                    android:maxLength="10"
                    android:padding="12dp"
                    android:singleLine="true"
                    android:textColor="#222222"
                    android:textSize="14sp"/>

                <!-- PASSWORD CONTAINER -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_regular"
                        android:hint="🔒   Password"
                        android:inputType="textPassword"
                        android:padding="8dp"
                        android:singleLine="true"
                        android:textColor="#222222"
                        android:textSize="14sp"/>

                    <TextView
                        android:id="@+id/tvTogglePassword"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="◉"
                        android:textColor="#075B37"
                        android:textSize="21sp"/>

                </LinearLayout>

                <!-- FORGOT PASSWORD -->

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="10dp"
                    android:padding="4dp"
                    android:text="Forgot Password?"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="#075B37"
                    android:textSize="13sp"/>

                <!-- LOGIN BUTTON -->

                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_primary_button"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Login"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

                <!-- OR DIVIDER -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="──────────  or  ──────────"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#777777"
                    android:textSize="13sp"/>

                <!-- OTP BUTTON -->

                <Button
                    android:id="@+id/btnOtp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_otp_button"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="▣  Login with OTP"
                    android:textAllCaps="false"
                    android:textColor="#075B37"
                    android:textSize="15sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- BOTTOM LANDSCAPE IMAGE -->

        <ImageView
            android:id="@+id/ivFooterScene"
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginTop="0dp"
            android:src="@drawable/login_landscape"
            android:scaleType="fitXY"
            android:adjustViewBounds="false"
            android:contentDescription="Anganwadi Kendra landscape"/>

    </LinearLayout>

</ScrollView>
