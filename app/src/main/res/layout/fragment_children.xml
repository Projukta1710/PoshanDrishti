<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDF9"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/poshan_logo"
                android:scaleType="fitCenter"
                android:contentDescription="PoshanDrishti logo"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="PoshanDrishti"
                android:textColor="#123C25"
                android:textSize="21sp"
                android:textStyle="bold"
                android:paddingStart="8dp"/>

            <TextView
                android:layout_width="42dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="♧"
                android:textColor="#123C25"
                android:textSize="30sp"/>
        </LinearLayout>

        <!-- Page heading -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Children"
            android:textColor="#111111"
            android:textSize="32sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage registered children"
            android:textColor="#26352C"
            android:textSize="17sp"/>

        <!-- Total children card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="98dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_dashboard"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="52dp"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_children_group"
                app:tint="#087A3A"
                android:contentDescription="Children group"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Children"
                    android:textColor="#111111"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/totalChildrenCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#111111"
                    android:textSize="34sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#075A2B"
                android:textSize="38sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Search -->
        <EditText
            android:id="@+id/etSearchChildren"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:hint="⌕  Search by name or ID"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:singleLine="true"
            android:textColor="#222222"
            android:textColorHint="#56605A"
            android:textSize="16sp"
            android:inputType="text"/>

        <!-- Filters -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="15dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filterAll"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_primary_button"
                android:gravity="center"
                android:text="All (124)"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/filterNormal"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.15"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_normal_card"
                android:gravity="center"
                android:text="Normal (105)"
                android:textColor="#17251B"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/filterMAM"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.95"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_mam_card"
                android:gravity="center"
                android:text="MAM (14)"
                android:textColor="#392D12"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/filterSAM"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="0.8"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_sam_card"
                android:gravity="center"
                android:text="SAM (5)"
                android:textColor="#651F1F"
                android:textSize="12sp"/>
        </LinearLayout>
        <!-- Dynamic Children List -->
        <LinearLayout
            android:id="@+id/childrenList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Empty State -->
        <TextView
            android:id="@+id/txtNoChildren"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="No children registered yet.\nTap + Add Child to get started."
            android:textColor="#56605A"
            android:textSize="16sp"
            android:padding="20dp"
            android:visibility="visible" />


        <!-- Add Child -->
        <Button
            android:id="@+id/btnAddChild"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="#087343"
            android:text="＋  Add Child"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>
</ScrollView>
