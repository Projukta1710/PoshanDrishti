<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F4F9F2">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <ScrollView
        android:id="@+id/homeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnMenu"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="☰"
                    android:textSize="30sp"
                    android:textColor="#07552F"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:contentDescription="Open navigation menu"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:text="🌿 PoshanDrishti"
                        android:textColor="#07552F"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Monitor • Assess • Nourish • Grow"
                        android:textColor="#376B4B"
                        android:textSize="10sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:text="🔔"
                    android:textSize="27sp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- CENTRE SELECTOR -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:background="#FFFFFF"
                android:text="📍  Anganwadi Centre 12  •  Satna  ⌄"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- WELCOME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="155dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="12dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:text="Hello, Sunita 👋"
                        android:textColor="#07552F"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Tuesday, 10 November 2026"
                        android:textColor="#666666"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="✓ Synced"
                        android:textColor="#16833E"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <TextView
                    android:text="👩🏻‍🍼"
                    android:textSize="65sp"
                    android:gravity="center"
                    android:layout_width="110dp"
                    android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- CHILD STATISTICS -->
            <TextView
                android:text="Children Overview"
                android:textColor="#07552F"
                android:textSize="19sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="105dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginEnd="4dp">

                    <TextView
                        android:text="👥 Total"
                        android:textSize="13sp"
                        android:textColor="#222222"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="48"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#07552F"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="Enrolled"
                        android:textSize="11sp"
                        android:textColor="#555555"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#DDF5DB"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="3dp">

                    <TextView
                        android:text="✓ Normal"
                        android:textSize="13sp"
                        android:textColor="#07552F"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="36"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#07552F"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="75%"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FFF0C9"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="3dp">

                    <TextView
                        android:text="⚠ MAM"
                        android:textSize="13sp"
                        android:textColor="#805400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="9"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#805400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="19%"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="#FCE0E0"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:text="! SAM"
                        android:textSize="13sp"
                        android:textColor="#A51C1C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="3"
                        android:textSize="29sp"
                        android:textStyle="bold"
                        android:textColor="#A51C1C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:text="6%"
                        android:textSize="11sp"
                        android:textColor="#333333"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>

            <!-- QUICK ACTIONS -->
            <TextView
                android:text="▣  Quick Actions"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:orientation="horizontal">

                <TextView
                    android:text="👤+\nAdd Child"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#07552F"
                    android:gravity="center"
                    android:background="#DFF4D9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"/>

                <TextView
                    android:text="📏\nMeasure\nGrowth"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:gravity="center"
                    android:background="#08783E"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"/>

                <TextView
                    android:text="📅\nFollow-up"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#805400"
                    android:gravity="center"
                    android:background="#FFE8D0"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"/>

                <TextView
                    android:text="📦\nRations"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#49317A"
                    android:gravity="center"
                    android:background="#EDE2FA"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- TODAY'S TASKS -->
            <TextView
                android:text="▤  Today's Tasks"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:text="📋  Measurements due                         5"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="📅  Follow-ups due                             2"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="➜  Referrals pending                         1"
                    android:textSize="15sp"
                    android:textColor="#222222"
                    android:padding="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- GROWTH TREND -->
            <TextView
                android:text="📊  Growth Trend"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:background="#FFFFFF"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:text="📈  Overall growth"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#07552F"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="+12% this month"
                    android:textSize="14sp"
                    android:textColor="#16833E"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- NEEDS ATTENTION -->
            <TextView
                android:text="◎  Needs Attention"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:text="🔴  Aarav          18 months\n       Follow-up 3 days overdue     SAM"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:text="🔴  Diya             26 months\n       Referral pending                 SAM"
                    android:textSize="15sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
        <FrameLayout
            android:id="@+id/pageContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />

    <!-- BOTTOM NAVIGATION -->
    <include
        layout="@layout/layout_bottom_navigation"/>

</LinearLayout>

    <!-- SIDE NAVIGATION DRAWER -->
    <ScrollView
        android:id="@+id/navigationDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:elevation="16dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- BRAND HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:padding="22dp"
                android:background="#E5F3DF">

                <ImageView
                    android:layout_width="65dp"
                    android:layout_height="65dp"
                    android:src="@drawable/poshan_logo"
                    android:contentDescription="PoshanDrishti Logo"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PoshanDrishti"
                    android:textColor="#07552F"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitor • Assess • Nourish • Grow"
                    android:textColor="#376B4B"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- WORKER DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello, Sunita! 👋"
                    android:textColor="#07552F"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anganwadi Worker"
                    android:textColor="#777777"
                    android:textSize="13sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anganwadi Centre 12, Satna"
                    android:textColor="#555555"
                    android:textSize="12sp"
                    android:layout_marginTop="5dp"/>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"/>

            <!-- MENU ITEMS -->
            <TextView
                android:id="@+id/menuHome"
                style="@style/DrawerMenuItem"
                android:text="⌂    Home"/>

            <TextView
                android:id="@+id/menuCentre"
                style="@style/DrawerMenuItem"
                android:text="My Anganwadi Centre"/>

            <TextView
                android:id="@+id/menuBeneficiaries"
                style="@style/DrawerMenuItem"
                android:text="Beneficiary Registration"/>

            <TextView
                android:id="@+id/menuSchemes"
                style="@style/DrawerMenuItem"
                android:text="Nutrition Schemes"/>

            <TextView
                android:id="@+id/menuNotifications"
                style="@style/DrawerMenuItem"
                android:text="Notifications     (3)"/>

            <TextView
                android:id="@+id/menuSync"
                style="@style/DrawerMenuItem"
                android:text="Sync Data"/>

            <TextView
                android:id="@+id/menuHistory"
                style="@style/DrawerMenuItem"
                android:text="Activity History"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EEEEEE"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/menuHelp"
                style="@style/DrawerMenuItem"
                android:text="Help &amp; Support"/>

            <TextView
                android:id="@+id/menuAbout"
                style="@style/DrawerMenuItem"
                android:text="About PoshanDrishti"/>

            <TextView
                android:id="@+id/menuLogout"
                style="@style/DrawerMenuItem"
                android:text="Logout"
                android:textColor="#C62828"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PoshanDrishti v1.0.0"
                android:gravity="center"
                android:padding="18dp"
                android:textColor="#888888"
                android:textSize="11sp"/>

        </LinearLayout>

    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>