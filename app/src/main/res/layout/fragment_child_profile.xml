<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDF9"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackProfile"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textSize="42sp"
                android:textColor="#07552B"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Child Profile"
                android:textColor="#111111"
                android:textSize="25sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/btnEditProfile"
                android:layout_width="45dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="✎"
                android:textSize="28sp"
                android:textColor="#07552B"/>
        </LinearLayout>

        <!-- Child information card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp"
            android:background="@drawable/bg_card_white">

            <ImageView
                android:id="@+id/imgProfileChild"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:src="@drawable/poshan_logo"
                android:scaleType="centerCrop"
                android:contentDescription="Child profile picture"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/txtProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ananya Verma"
                    android:textColor="#111111"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/txtProfileDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="ID: PD002  |  Female  |  2y 5m"
                    android:textColor="#333333"
                    android:textSize="13sp"/>
            </LinearLayout>

            <TextView
                android:layout_width="60dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="MAM"
                android:textColor="#493500"
                android:textStyle="bold"
                android:background="#FFE18A"/>
        </LinearLayout>

        <!-- Tabs -->
        <LinearLayout
            android:id="@+id/profileTabs"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:background="#F0F1ED"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabOverview"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:gravity="center"
                android:text="Overview"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="17sp"
                android:background="@drawable/bg_primary_button"/>

            <TextView
                android:id="@+id/tabGrowth"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_margin="3dp"
                android:gravity="center"
                android:text="Growth &amp; Status"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </LinearLayout>

        <!-- Overview content -->
        <LinearLayout
            android:id="@+id/overviewContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Guardian details -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_card_white">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="♙   Guardian\n     Pooja Verma"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:padding="6dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="☎   Mobile\n     +91 9876543210"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:padding="6dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDDDDD"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▦   Registered On\n     05 Jan 2026"
                    android:textColor="#111111"
                    android:textSize="17sp"
                    android:padding="6dp"/>
            </LinearLayout>

            <!-- Nutritional Status -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp"
                android:background="#FFF4D8">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:text="◉"
                    android:textSize="42sp"
                    android:textColor="#E8AE14"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nutritional Status"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:textSize="17sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAM (Moderate Acute Malnutrition)"
                        android:textColor="#704018"
                        android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Follow-up -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp"
                android:background="#E5F4E3">

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#087336"
                    android:textSize="36sp"
                    android:gravity="center"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Follow-up"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:textSize="17sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Due on 20 May 2026"
                        android:textColor="#111111"
                        android:textSize="15sp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#07552B"
                    android:textSize="34sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Growth content -->
        <LinearLayout
            android:id="@+id/growthContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Growth Measurements"
                android:textColor="#07552B"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:padding="18dp"
                android:background="@drawable/bg_card_white"
                android:text="Weight: 12.4 kg\nHeight: 92 cm\nMUAC: 12.0 cm"
                android:textColor="#222222"
                android:textSize="17sp"/>
        </LinearLayout>

        <!-- Add Measurement -->
        <Button
            android:id="@+id/btnAddMeasurement"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_primary_button"
            android:text="+   Add Measurement"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>
