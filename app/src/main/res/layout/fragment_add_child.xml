<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDF9"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBackAddChild"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="‹"
                android:textSize="42sp"
                android:textColor="#123C25"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Child"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#111111"
                android:paddingStart="10dp"/>
        </LinearLayout>

        <!-- Child Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Child Details"
                android:drawableStart="@drawable/ic_nav_children"
                android:drawableTint="#087343"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:textColor="#075A2B"
                android:textStyle="bold"
                android:textSize="20sp"
                android:background="#E0F1E2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Full Name *"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Enter child's name"
                android:textColorHint="#8A8A8A"
                android:paddingStart="14dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:inputType="textPersonName"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date of Birth *"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <EditText
                        android:id="@+id/etDateOfBirth"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="Select date"
                        android:textColorHint="#8A8A8A"
                        android:paddingStart="12dp"
                        android:focusable="false"
                        android:clickable="true"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gender *"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <Spinner
                        android:id="@+id/spGender"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:paddingStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Growth Measurement -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Growth Measurement"
                android:drawableStart="@drawable/ic_nav_assess"
                android:drawableTint="#087343"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:textColor="#075A2B"
                android:textStyle="bold"
                android:textSize="19sp"
                android:background="#E0F1E2"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingEnd="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Weight (kg) *"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="15sp"/>

                    <EditText
                        android:id="@+id/etWeight"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="e.g., 12.4"
                        android:textColorHint="#8A8A8A"
                        android:paddingStart="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Height (cm) *"
                        android:textStyle="bold"
                        android:textColor="#111111"
                        android:textSize="15sp"/>

                    <EditText
                        android:id="@+id/etHeight"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_input"
                        android:hint="e.g., 92"
                        android:textColorHint="#8A8A8A"
                        android:paddingStart="12dp"
                        android:inputType="numberDecimal"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="MUAC (cm)"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etMuac"
                android:layout_width="165dp"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="e.g., 12.0"
                android:textColorHint="#8A8A8A"
                android:paddingStart="12dp"
                android:inputType="numberDecimal"/>
        </LinearLayout>

        <!-- Parent / Guardian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card_white"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:text="Parent / Guardian"
                android:drawableStart="@drawable/outline_person_24"
                android:drawableTint="#087343"
                android:drawablePadding="10dp"
                android:paddingStart="10dp"
                android:textColor="#075A2B"
                android:textStyle="bold"
                android:textSize="20sp"
                android:background="#E0F1E2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardian Name *"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etGuardianName"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Enter guardian's name"
                android:textColorHint="#8A8A8A"
                android:paddingStart="14dp"
                android:inputType="textPersonName"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mobile Number"
                android:textColor="#111111"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <EditText
                android:id="@+id/etGuardianMobile"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="Enter mobile number"
                android:textColorHint="#8A8A8A"
                android:paddingStart="14dp"
                android:inputType="phone"
                android:maxLength="10"/>
        </LinearLayout>

        <!-- Save Child -->
        <Button
            android:id="@+id/btnSaveChild"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_primary_button"
            android:backgroundTint="#087343"
            android:text="▣  Save Child"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textSize="18sp"/>

    </LinearLayout>
</ScrollView>
